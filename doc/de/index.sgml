      </imageobject></inlinemediaobject></entry>
      <entry>0 = W0</entry>
      <entry morerows="1" valign="middle">&nbsp;</entry>
    </row>
    <row>
      <entry><inlinemediaobject><imageobject>
        <imagedata fileref="../commonimages/signal-ws-1.png">
      </imageobject></inlinemediaobject></entry>
      <entry>1 = W1</entry>
