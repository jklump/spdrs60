    </row>
    
    <row>
      <entry morerows="1" valign="middle">Sperrsignal, Rangiersignal</entry>
      <entry><inlinemediaobject><imageobject>
        <imagedata fileref="../commonimages/signal-ss-0.png">
      </imageobject></inlinemediaobject></entry>
      <entry>0 = Sh0</entry>
      <entry morerows="1" valign="middle">Ist in drei Varianten
      vorhanden: eine oder zwei Rangierstraßentasten,
      Zughilfsstraßentaste</entry>
    </row>
    <row>
      <entry><inlinemediaobject><imageobject>
