    </row>
    <row>
      <entry><graphic fileref="../commonimages/taste-ufgt.png"></entry>
      <entry>taste_ufgt</entry>
      <entry>Umfahrgruppentaste zum Einstellen von Umfahrstraßen;
      Mittelweichengruppentaste hat noch keine Funktion</entry>
      <entry>0</entry>
      <entry>Hindergrundfarbe nicht veränderbar</entry>
      <entry>&nbsp;</entry>
    </row>
    <row>
      <entry><graphic fileref="../commonimages/taste-sgt.png"></entry>
      <entry>taste_sgt</entry>
      <entry>Signalgruppentaste zum manuellen Einstellen von Signalen</entry>
