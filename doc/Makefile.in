	$(dist_enimages_DATA) Makefile.am Makefile.in
all: all-am

.SUFFIXES:
$(srcdir)/Makefile.in:  Makefile.am  $(top_srcdir)/configure.ac $(ACLOCAL_M4)
	cd $(top_srcdir) && \
	  $(AUTOMAKE) --gnu  doc/Makefile
Makefile:  $(srcdir)/Makefile.in  $(top_builddir)/config.status
	cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)
uninstall-info-am:
dehtmlDATA_INSTALL = $(INSTALL_DATA)
install-dehtmlDATA: $(dehtml_DATA)
	@$(NORMAL_INSTALL)
	$(mkinstalldirs) $(DESTDIR)$(dehtmldir)
	@list='$(dehtml_DATA)'; for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " $(dehtmlDATA_INSTALL) $$d$$p $(DESTDIR)$(dehtmldir)/$$f"; \
	  $(dehtmlDATA_INSTALL) $$d$$p $(DESTDIR)$(dehtmldir)/$$f; \
	done

uninstall-dehtmlDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(dehtml_DATA)'; for p in $$list; do \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " rm -f $(DESTDIR)$(dehtmldir)/$$f"; \
	  rm -f $(DESTDIR)$(dehtmldir)/$$f; \
	done
dist_commonimagesDATA_INSTALL = $(INSTALL_DATA)
install-dist_commonimagesDATA: $(dist_commonimages_DATA)
	@$(NORMAL_INSTALL)
	$(mkinstalldirs) $(DESTDIR)$(commonimagesdir)
