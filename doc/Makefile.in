	  echo " $(dist_commonimagesDATA_INSTALL) $$d$$p $(DESTDIR)$(commonimagesdir)/$$f"; \
	  $(dist_commonimagesDATA_INSTALL) $$d$$p $(DESTDIR)$(commonimagesdir)/$$f; \
	done

uninstall-dist_commonimagesDATA:
