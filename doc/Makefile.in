mkinstalldirs = $(SHELL) $(top_srcdir)/mkinstalldirs
CONFIG_HEADER = $(top_builddir)/spdrs60/config.h
CONFIG_CLEAN_FILES =
DIST_SOURCES =
DATA = $(dehtml_DATA) $(dist_commonimages_DATA) $(dist_deimages_DATA) \
	$(dist_enimages_DATA) $(enhtml_DATA)

